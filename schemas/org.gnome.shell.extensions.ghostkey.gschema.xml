<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.ghostkey" path="/org/gnome/shell/extensions/ghostkey/">
    
    <key name="ghost-mode-enabled" type="b">
      <default>false</default>
      <summary>Ghost mode enabled</summary>
      <description>Whether the ghost mode (key silencing) is currently active</description>
    </key>
    
    <key name="silence-super-key" type="b">
      <default>true</default>
      <summary>Silence Super key</summary>
      <description>Silence the Super key (overlay key)</description>
    </key>
    
    <key name="silence-window-menu" type="b">
      <default>true</default>
      <summary>Silence window menu</summary>
      <description>Silence the activate-window-menu keybinding</description>
    </key>
    
    <key name="silence-input-source" type="b">
      <default>true</default>
      <summary>Silence input source switch</summary>
      <description>Silence the switch-input-source keybinding</description>
    </key>
    
    <key name="silence-app-view" type="b">
      <default>true</default>
      <summary>Silence application view</summary>
      <description>Silence the toggle-application-view keybinding</description>
    </key>
    
    <key name="silence-app-shortcuts" type="b">
      <default>true</default>
      <summary>Silence application shortcuts</summary>
      <description>Silence the open-new-window-application and switch-to-application keybindings (1-9)</description>
    </key>
    
    <key name="silence-dash-hotkeys" type="b">
      <default>true</default>
      <summary>Silence dash hotkeys</summary>
      <description>Silence the dash-to-dock hot-keys setting</description>
    </key>
    
    <key name="original-keybindings-backup" type="s">
      <default>''</default>
      <summary>Original keybindings backup</summary>
      <description>JSON string storing the original keybinding values before silencing</description>
    </key>
    
    <key name="original-overlay-key" type="s">
      <default>''</default>
      <summary>Original overlay key value</summary>
      <description>Backup of the original org.gnome.mutter overlay-key value</description>
    </key>
    
    <key name="original-window-menu" type="s">
      <default>''</default>
      <summary>Original window menu keybinding</summary>
      <description>Backup of the original activate-window-menu keybinding</description>
    </key>
    
    <key name="original-input-source" type="s">
      <default>''</default>
      <summary>Original input source keybinding</summary>
      <description>Backup of the original switch-input-source keybinding</description>
    </key>
    
    <key name="original-app-view" type="s">
      <default>''</default>
      <summary>Original app view keybinding</summary>
      <description>Backup of the original toggle-application-view keybinding</description>
    </key>
    
    <key name="original-app-shortcuts" type="s">
      <default>''</default>
      <summary>Original app shortcuts</summary>
      <description>JSON object storing original values for application shortcuts (1-9)</description>
    </key>
    
    <key name="original-dash-hotkeys" type="b">
      <default>false</default>
      <summary>Original dash hotkeys state</summary>
      <description>Backup of the original dash-to-dock hot-keys boolean value</description>
    </key>
    
  </schema>
</schemalist>
